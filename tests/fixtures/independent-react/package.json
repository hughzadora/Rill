{
  "name": "independent-react-stock-console",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4178 --strictPort",
    "lint": "biome check --indent-style=space src e2e",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run src/Counter.test.tsx",
    "test:integration": "vitest run src/main.integration.test.tsx",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep @e2e",
    "test:a11y": "playwright test --grep @a11y",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
