{
  "json": {},
  "markdown": {},
  "toml": {},
  "yaml": {},
  "excludes": [
    ".changeset/*.md",
    "!/.changeset/README.md",
    "CHANGELOG.md",
    "packages/*/CHANGELOG.md",
    "specs/*/tasks.md",
    "**/node_modules/**",
    "**/dist/**",
    "**/reports/**",
    "**/*.api.md",
    "**/temp/**",
    "**/.turbo/**",
    "**/.worktrees/**",
    "**/bun.lock",
    "**/mise.lock",
    "**/uv.lock",
    ".mise/locks/**",
    ".omp/commands/**",
    ".specify/extensions/**",
    ".specify/extensions.yml",
    ".specify/integrations/**",
    ".specify/workflows/**",
    ".specify/templates/**",
    ".specify/init-options.json",
    ".specify/integration.json"
  ],
  "plugins": [
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "npm:@dprint/toml@0.10.0",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
