{
  "name": "rill-workflow",
  "image": "oven/bun:1.4.5",
  "features": {
    "ghcr.io/devcontainers/features/gh-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/gitleaks:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions",
        "redhat.vscode-yaml"
      ]
    }
  },
  "postCreateCommand": "bun install",
  "remoteUser": "bun",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/.env.test,target=/workspace/.env.test,type=bind,consistency=cached"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "runArgs": ["--env-file", ".devcontainer/.env.test"]
}
