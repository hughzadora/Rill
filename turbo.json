{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#docs:check": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    },
    "api:check": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "mutation": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    }
  }
}
