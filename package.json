{
  "name": "rill-workflow",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun src/template.ts",
    "build:lib": "tsdown",
    "changeset:add": "changeset add",
    "changeset:version": "changeset version",
    "changeset:changelog": "changeset changelog",
    "check:pub": "publint --pack bun",
    "dprint": "dprint",
    "arch:check": "depcruise --config .dependency-cruiser.cjs src/",
    "ast-grep": "ast-grep test --config sgconfig.yml && ast-grep scan --config sgconfig.yml",
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "test:mutation": "stryker run",
    "test": "bun tests/tooling/run-suite.ts ordinary",
    "test:behavior": "bun tests/tooling/run-suite.ts behavior",
    "test:qualification": "bun tests/tooling/run-suite.ts qualification",
    "knip": "knip",
    "format": "oxfmt --write --disable-nested-config . && dprint fmt",
    "format:check": "oxfmt --check --disable-nested-config . && dprint check",
    "lint": "oxlint --type-aware --deny-warnings src tests evals packages",
    "lint:fix": "oxlint --type-aware --fix src tests evals packages",
    "eval": "bun evals/run.ts",
    "dev": "bun src/template.ts",
    "release": "turbo run build && turbo run check:pub && changeset publish",
    "gh:safe": "bun run packages/tooling/gh-safe.ts",
    "commitlint": "commitlint",
    "api-extractor": "api-extractor run --local --config api-extractor.json"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "qs": "6.16.1"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "neverthrow": "^8.2.0",
    "ts-pattern": "^5.9.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ast-grep/cli": "^0.51.3",
    "@changesets/cli": "^3.0.3",
    "@changesets/git": "^4.0.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@microsoft/api-extractor": "^7.60.2",
    "@stryker-mutator/core": "^10.1.1",
    "@types/bun": "1.4.5",
    "dependency-cruiser": "^18.9.0",
    "dprint": "0.65.0",
    "fast-check": "^4.11.0",
    "knip": "^6.48.0",
    "lefthook": "^2.2.4",
    "minimatch": "11.0.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "publint": "^0.3.25",
    "qs": "6.16.0",
    "tsdown": "^0.23.7",
    "tsrs": "7.1.0-beta.tsrs5",
    "turbo": "^2.11.13",
    "zod": "^4.6.7"
  },
  "packageManager": "bun@1.4.5"
}
