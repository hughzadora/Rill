{
  "name": "rill-local-quality-foundation",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.toml": [
      "mise exec --locked -- taplo fmt"
    ],
    "*.{js,ts,jsx,tsx,json}": [
      "mise exec --locked -- biome check --write --unsafe --no-errors-on-unmatched"
    ],
    "*.py": [
      "mise exec --locked -- uv run ruff check --fix",
      "mise exec --locked -- uv run ruff format"
    ],
    "*.sh": [
      "mise exec --locked -- shfmt -w -i 2 -ci",
      "mise exec --locked -- shellcheck -x"
    ],
    "*.md": [
      "mise exec --locked -- markdownlint-cli2 --fix"
    ],
    "*": [
      "mise exec --locked -- typos --force-exclude --exclude \"**/.mise/locks/**\""
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "jsdom": "^31.0.1",
    "knip": "^6.46.1",
    "lint-staged": "^17.6.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
