{
  "name": "@rill/factory",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "description": "Rill native-first software factory CLI (development candidate)",
  "bin": {
    "rill": "./dist/cli.js"
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "bun run clean && bun build ./src/*.ts --no-bundle --target=node --outdir ./dist",
    "typecheck": "bun check --no-script",
    "lint": "biome lint src tests",
    "format:check": "bun fmt --check src tests package.json tsconfig.json",
    "test": "bun test --parallel=2 --timings=.github/test-timings.json ./tests/*.test.mjs",
    "test:coverage": "c8 --all --src dist --include 'dist/**/*.js' --check-coverage --per-file --lines 80 --reporter text node --test tests/*.test.mjs",
    "ci": "bun run --parallel lint typecheck format:check build && bun run --parallel test test:coverage",
    "test:changed": "bun test --changed=main --timings=.github/test-timings.json ./tests/*.test.mjs",
    "test:timings": "bun test --timings=.github/test-timings.json --update-timings ./tests/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "c8": "12.0.0",
    "rimraf": "6.1.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "semver": "7.8.6"
  }
}
