{
  "name": "rill",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "docs:check": "tsrs --noEmit -p tsconfig.json --types bun && bun tooling/document-metadata.mts",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --deny-warnings --no-error-on-unmatched-pattern packages",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern . && dprint check",
    "commitlint": "commitlint",
    "fmt": "oxfmt --no-error-on-unmatched-pattern . && dprint fmt",
    "arch:check": "depcruise packages",
    "api:check": "turbo run api:check",
    "deadcode:check": "knip --include files,exports,types",
    "rules:check": "ast-grep scan",
    "mutation": "turbo run mutation"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.3",
    "@changesets/cli": "3.1.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@microsoft/api-extractor": "7.60.2",
    "@types/bun": "1.4.5",
    "dependency-cruiser": "18.9.0",
    "dprint": "0.65.0",
    "knip": "6.49.0",
    "lefthook": "^2.2.4",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "tsrs": "7.1.0-beta.tsrs5",
    "turbo": "^2.11.13",
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.5"
}
