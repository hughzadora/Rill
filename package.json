{
  "name": "@rill/factory",
  "private": true,
  "type": "module",
  "description": "Rill native-first software factory CLI (development candidate)",
  "bin": {
    "rill": "./dist/cli.js"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "tsc --project tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "ci": "pnpm run check && pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
