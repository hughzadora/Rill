{
  "name": "@rill/factory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "description": "Rill native-first software factory CLI (development candidate)",
  "bin": {
    "rill": "./dist/cli.js"
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "tsc --project tsconfig.json --noEmit",
    "lint": "biome check src tests package.json tsconfig.json biome.json",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "c8 --all --src dist --include 'dist/**/*.js' --check-coverage --per-file --lines 80 --reporter text node --test tests/*.test.mjs",
    "ci": "pnpm run lint && pnpm run check && pnpm run build && pnpm run test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "24.19.2",
    "c8": "12.0.0",
    "typescript": "7.0.2"
  }
}
