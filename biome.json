{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "files": {
    "includes": [
      "**",
      "!!packages/quality",
      "!!.mise",
      "!!.agents",
      "!!.playwright-cli"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
