{
  "description": "Project-local SessionStart fallback. Its content requires native trust review.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.rill/plugin/hooks/session-start.mjs\"",
            "statusMessage": "Checking Rill product specification",
            "timeout": 3,
            "additionalContextLimit": 500
          }
        ]
      }
    ]
  }
}
