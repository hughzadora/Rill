{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "reporters": ["clear-text", "progress"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "tsconfigFile": "tsconfig.json",
  "mutate": ["src/ts/**/*.{ts,tsx}", "!src/ts/main.tsx", "!src/ts/components/ui/**"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "concurrency": 4,
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [
    "tsconfig.json",
    "**/.venv/**",
    "**/mutants/**",
    "**/.stryker-tmp/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**"
  ]
}
