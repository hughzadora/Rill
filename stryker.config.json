{
  "$schema": "./node_modules/@stryker-mutator/core/config.schema.json",
  "packageManager": "bun",
  "testRunner": "bun",
  "testCommand": "bun run test",
  "mutator": ["typescript", "javascript"],
  "thresholds": {
    "high": 75,
    "low": 60,
    "break": 50
  },
  "concurrency": 4,
  "coverageAnalysis": "all",
  "exclude": ["node_modules", "dist", "reports", "tests/tooling", "template"]
}
