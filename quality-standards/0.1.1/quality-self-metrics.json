{
  "schemaVersion": 1,
  "purpose": "Quality profile implementation and sample source gates",
  "sourcePaths": [
    "tools",
    "tests",
    "quality-fixtures/node",
    "quality-fixtures/react",
    "quality-fixtures/web/src",
    "src/ts"
  ],
  "extensions": [
    ".ts",
    ".tsx"
  ],
  "limits": {
    "maximumCyclomaticComplexity": 15,
    "maximumFunctionLines": 50,
    "maximumParameters": 6,
    "maximumCodeLinesPerFile": 500
  },
  "optionalSourcePaths": [
    "quality-fixtures/web/vite.config.ts",
    "vitest.config.ts"
  ]
}
