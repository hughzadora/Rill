{
  "schemaVersion": 1,
  "purpose": "Rill #18 existing TypeScript source gate",
  "sourcePaths": [
    "tools",
    "tests"
  ],
  "extensions": [
    ".ts",
    ".tsx"
  ],
  "limits": {
    "maximumCyclomaticComplexity": 15,
    "maximumFunctionLines": 50,
    "maximumParameters": 6,
    "maximumCodeLinesPerFile": 500
  },
  "optionalSourcePaths": [
    "vitest.config.ts",
    "src/ts"
  ]
}
