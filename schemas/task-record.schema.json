{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "taskUrl",
    "kind",
    "createdAt",
    "revision",
    "source",
    "payload"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "taskUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/]+/[^/]+/issues/[1-9][0-9]*$"
    },
    "kind": {
      "enum": [
        "requirement",
        "correction",
        "attempt",
        "diagnosis",
        "checkpoint"
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threadId"],
      "properties": {
        "threadId": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string", "minLength": 1 }
      }
    },
    "payload": { "type": "object" }
  }
}
