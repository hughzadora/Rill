{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "sourceRevision",
    "policyEntry",
    "nativeEntries",
    "projectSchemaVersions",
    "runtimeVersions",
    "toolCapabilities",
    "rules",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "policyEntry": { "type": "string", "minLength": 1 },
    "nativeEntries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hooks", "mcp"],
      "properties": {
        "hooks": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "mcp": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "projectSchemaVersions": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    },
    "runtimeVersions": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
      }
    },
    "toolCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/id" }
    },
    "rules": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": { "id": { "$ref": "#/definitions/id" } }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/definitions/digest" }
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
