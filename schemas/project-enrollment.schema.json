{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "standard",
    "tools",
    "exceptions"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "digest": { "$ref": "#/definitions/digest" }
      }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/definitions/toolBinding" }
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/definitions/exception" }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+)$"
    },
    "toolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "argv", "cwd", "version", "inapplicability"],
      "properties": {
        "capability": { "$ref": "#/definitions/id" },
        "argv": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "cwd": { "$ref": "#/definitions/relativePath" },
        "version": { "type": ["string", "null"], "minLength": 1 },
        "inapplicability": { "type": ["string", "null"], "minLength": 1 }
      },
      "oneOf": [
        {
          "properties": {
            "argv": { "type": "array", "minItems": 1 },
            "version": { "type": "string", "minLength": 1 },
            "inapplicability": { "type": "null" }
          }
        },
        {
          "properties": {
            "argv": { "type": "array", "maxItems": 0 },
            "version": { "type": "null" },
            "inapplicability": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "disposition",
        "reason",
        "source",
        "reviewTrigger"
      ],
      "properties": {
        "ruleId": { "$ref": "#/definitions/id" },
        "disposition": { "enum": ["replace", "inapplicable"] },
        "replacement": { "$ref": "#/definitions/id" },
        "reason": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "reviewTrigger": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        {
          "properties": { "disposition": { "const": "replace" } },
          "required": ["replacement"]
        },
        {
          "properties": { "disposition": { "const": "inapplicable" } },
          "not": { "required": ["replacement"] }
        }
      ]
    }
  }
}
