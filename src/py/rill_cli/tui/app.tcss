Screen {
    background: #0e1721;
    color: #e6f0f6;
}

Header { background: #182632; color: #a7e8dc; }
Footer { background: #182632; color: #c9d8e6; }

#topbar { height: 3; background: #172631; padding: 0 2; align: left middle; }
#topbar Static { width: 1fr; color: #80d5c6; text-style: bold; }
#search { width: 35; border: tall #325064; }
#main { height: 1fr; padding: 1; }
#left { width: 3fr; height: 1fr; }
#right { width: 2fr; height: 1fr; border-left: solid #2c4253; padding: 0 1; }
#projects { height: 42%; }
#assets { height: 1fr; }
.section-title { height: 2; padding: 0 1; color: #88daca; text-style: bold; }
DataTable { background: #14212d; color: #e6f0f6; border: round #31485c; }
DataTable:focus { border: round #75cbbb; }
DataTable > .datatable--header { background: #223647; color: #b0dfd6; text-style: bold; }
#details { height: 32%; padding: 1; background: #14212d; border: round #31485c; }
#events { height: 1fr; background: #101d28; border: round #31485c; padding: 0 1; }
#actions { height: 3; background: #172631; padding: 0 1; }
#actions Button { margin: 0 1 0 0; min-width: 9; }
#status { height: 1; color: #92b2c5; background: #14212d; padding: 0 2; }

ModalScreen { align: center middle; background: #08111b 78%; }
#dialog { width: 74; max-width: 94%; height: auto; padding: 2; background: #172631; border: heavy #74c5b8; }
.modal-title { height: 3; color: #8ce3d4; text-style: bold; }
.modal-body { height: auto; color: #d5e6ee; padding: 0 1; }
.modal-actions { height: 4; align: right middle; margin-top: 1; }
.modal-actions Button { margin: 0 1; min-width: 12; }
.switch-line { height: 3; align: left middle; }
.switch-line Static { width: 1fr; }
#dialog Input { width: 1fr; margin-bottom: 1; }
#dialog Button:focus { border: tall #ace9de; }
