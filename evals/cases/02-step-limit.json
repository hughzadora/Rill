{
  "id": "eval-02-step-limit",
  "description": "Exceeding maxSteps fails the workflow and does not account the over-limit step.",
  "config": {
    "maxSteps": 2,
    "timeoutMs": 1000,
    "maxTokenBudget": 1000
  },
  "steps": [
    { "name": "start running", "event": { "type": "start" } },
    {
      "name": "first step accounted",
      "event": { "type": "step", "tokens": 5, "elapsedMs": 10 },
      "expect": { "status": "running", "steps": 1, "tokens": 5, "elapsedMs": 10 }
    },
    {
      "name": "second step accounted",
      "event": { "type": "step", "tokens": 5, "elapsedMs": 20 },
      "expect": { "status": "running", "steps": 2, "tokens": 10, "elapsedMs": 20 }
    },
    {
      "name": "third step breaches maxSteps",
      "event": { "type": "step", "tokens": 5, "elapsedMs": 30 },
      "expect": { "status": "failed", "steps": 2, "tokens": 10, "elapsedMs": 30 }
    },
    {
      "name": "terminal state ignores later events",
      "event": { "type": "finish" },
      "expect": { "status": "failed", "steps": 2, "tokens": 10, "elapsedMs": 30 }
    }
  ]
}
