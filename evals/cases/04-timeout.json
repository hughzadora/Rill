{
  "id": "04-timeout",
  "description": "Elapsed time past timeoutMs fails the workflow without accounting the over-limit step.",
  "config": {
    "maxSteps": 100,
    "timeoutMs": 300,
    "maxTokenBudget": 1000
  },
  "steps": [
    { "name": "start running", "event": { "type": "start" } },
    {
      "name": "in-flight step",
      "event": { "type": "step", "tokens": 5, "elapsedMs": 100 },
      "expect": { "status": "running", "steps": 1, "tokens": 5, "elapsedMs": 100 }
    },
    {
      "name": "elapsed time breaches timeoutMs",
      "event": { "type": "step", "tokens": 5, "elapsedMs": 400 },
      "expect": { "status": "failed", "steps": 1, "tokens": 5, "elapsedMs": 400 }
    }
  ]
}
