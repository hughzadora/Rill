{
  "id": "eval-01-golden-workflow",
  "description": "A workflow that respects every limit completes; a workflow that breaches one limit fails without accounting the over-limit work.",
  "config": {
    "maxSteps": 3,
    "timeoutMs": 1000,
    "maxTokenBudget": 100
  },
  "steps": [
    {
      "name": "start running",
      "event": { "type": "start" },
      "expect": { "status": "running", "steps": 0, "tokens": 0, "elapsedMs": 0 }
    },
    {
      "name": "in-flight step",
      "event": { "type": "step", "tokens": 10, "elapsedMs": 100 },
      "expect": { "status": "running", "steps": 1, "tokens": 10, "elapsedMs": 100 }
    },
    {
      "name": "finish",
      "event": { "type": "finish" },
      "expect": { "status": "completed", "steps": 1, "tokens": 10, "elapsedMs": 100 }
    }
  ]
}
