{
  "id": "eval-03-budget-limit",
  "description": "Exceeding maxTokenBudget fails the workflow without accounting the over-limit tokens; a timeout breach fails on elapsed time.",
  "config": {
    "maxSteps": 100,
    "timeoutMs": 500,
    "maxTokenBudget": 50
  },
  "steps": [
    { "name": "start running", "event": { "type": "start" } },
    {
      "name": "token spend within budget",
      "event": { "type": "step", "tokens": 40, "elapsedMs": 100 },
      "expect": { "status": "running", "steps": 1, "tokens": 40, "elapsedMs": 100 }
    },
    {
      "name": "token spend breaches budget",
      "event": { "type": "step", "tokens": 20, "elapsedMs": 200 },
      "expect": { "status": "failed", "steps": 1, "tokens": 40, "elapsedMs": 200 }
    }
  ]
}
