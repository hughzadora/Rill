{
  "$schema": "https://knip.dev/schema.json",
  "entry": ["src/**/*.ts", "tests/**/*.ts", "evals/**/*.ts", "packages/**/*.ts"],
  "project": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "evals/**/*.ts",
    "packages/**/*.ts",
    ".changeset/**"
  ],
  "ignore": ["stryker.config.json"],
