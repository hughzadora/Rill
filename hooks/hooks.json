{
  "description": "Rill task preservation. Native review/trust is required. Local hooks are bypassable.",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/tools/control-hook.ts\"",
            "timeout": 30,
            "statusMessage": "Saving Rill task and recovery gaps"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/tools/control-hook.ts\"",
            "timeout": 30,
            "additionalContextLimit": 5000,
            "statusMessage": "Restoring Rill task and pending reconciliation"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/tools/control-hook.ts\"",
            "timeout": 30,
            "statusMessage": "Checking actual repair diagnosis requirements"
          }
        ]
      },
      {
        "matcher": "github[._/]+(create_pull_request|merge_pull_request)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/tools/control-hook.ts\"",
            "timeout": 30,
            "statusMessage": "Verifying current delivery evidence and authority"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "repair_(check|diagnose|interpret)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/tools/control-hook.ts\"",
            "timeout": 30,
            "statusMessage": "Reading recorded repair outcomes"
          }
        ]
      }
    ]
  }
}
