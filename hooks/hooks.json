{
  "description": "Rill native SessionStart context routing (requires host trust)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "statusMessage": "Checking Rill project specification",
            "timeout": 3,
            "additionalContextLimit": 500
          }
        ]
      }
    ]
  }
}
