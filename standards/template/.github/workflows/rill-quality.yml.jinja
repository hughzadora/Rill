name: Rill Quality

on:
  pull_request:
  merge_group:
  workflow_dispatch:

permissions:
  contents: read

jobs:
{% if react or node %}
  typescript:
    name: TypeScript application gates
    runs-on: ubuntu-24.04
    env:
      CI: "true"
      PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD: "1"
    defaults:
      run:
        working-directory: [[ js_workspace | tojson ]]
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false
      - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4
        with:
          run_install: false
          package_json_file: [[ (js_workspace ~ "/package.json") | tojson ]]
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6
        with:
          node-version: [[ node_version | tojson ]]
          cache: pnpm
          cache-dependency-path: [[ (js_workspace ~ "/pnpm-lock.yaml") | tojson ]]
      - name: Install frozen workspace dependencies
        run: pnpm install --frozen-lockfile
{% if react %}
      - name: React source lint
        run: pnpm --dir [[ react_root | tojson ]] run lint
      - name: React TypeScript and public contracts
        run: pnpm --dir [[ react_root | tojson ]] run typecheck
      - name: React component unit tests
        run: pnpm --dir [[ react_root | tojson ]] run test:unit
      - name: React component/service integration
        run: pnpm --dir [[ react_root | tojson ]] run test:integration
      - name: React source coverage gate
        run: pnpm --dir [[ react_root | tojson ]] run test:coverage
      - name: React production build
        run: pnpm --dir [[ react_root | tojson ]] run build
      - name: Chrome E2E behavior
        run: pnpm --dir [[ react_root | tojson ]] run test:e2e
      - name: Chrome accessibility
        run: pnpm --dir [[ react_root | tojson ]] run test:a11y
{% endif %}
{% if node %}
      - name: Node source lint
        run: pnpm --dir [[ node_root | tojson ]] run lint
      - name: Node TypeScript and contracts
        run: pnpm --dir [[ node_root | tojson ]] run typecheck
      - name: Node unit behavior
        run: pnpm --dir [[ node_root | tojson ]] run test:unit
      - name: Node service integration and failure modes
        run: pnpm --dir [[ node_root | tojson ]] run test:integration
      - name: Node source coverage gate
        run: pnpm --dir [[ node_root | tojson ]] run test:coverage
      - name: Node production build
        run: pnpm --dir [[ node_root | tojson ]] run build
{% endif %}
      - name: Audit production Node dependencies
        run: pnpm audit --prod
{% endif %}
{% if python %}
  python:
    name: Python application gates
    runs-on: ubuntu-24.04
    defaults:
      run:
        working-directory: [[ python_root | tojson ]]
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@37802adc94f370d6bfd71619e3f0bf239e1f3b78 # v7
        with:
          version: "0.13.8"
      - name: Install frozen Python project
        run: uv sync --locked --dev
      - name: Ruff lint
        run: uv run --locked ruff check [[ python_sources | tojson ]] [[ python_tests | tojson ]]
      - name: Ruff format
        run: uv run --locked ruff format --check [[ python_sources | tojson ]] [[ python_tests | tojson ]]
      - name: Python static types
        run: uv run --locked mypy --strict [[ python_sources | tojson ]]
      - name: Python unit/regression and coverage
        run: uv run --locked pytest -q --cov=[[ python_sources | tojson ]] --cov-report=term-missing --cov-fail-under=[[ python_coverage ]] [[ python_tests | tojson ]]
      - name: Python real integration
        run: uv run --locked pytest -q [[ python_integration | tojson ]]
      - name: Python package build
        run: uv build --no-build-isolation
{% endif %}
{% if shell %}
  shell:
    name: Shell source and CLI behavior
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false
      - uses: jdx/mise-action@dba19683ed58901619b14f395a24841710cb4925 # v4.1.0
        with:
          install: false
      - name: Shell source static analysis
        shell: bash
        run: |
          scripts=()
          while IFS= read -r -d '' source; do
            case "$source" in
              *.sh) scripts+=("$source") ;;
              *)
                shebang=
                IFS= read -r shebang < "$source" || true
                if printf '%s\n' "$shebang" | grep -Eq '^#!.*(/|[ /])(ba)?sh([ /]|$)'; then
                  scripts+=("$source")
                fi
                ;;
            esac
          done < <(find [[ shell_sources | tojson ]] -type f -print0)
          if [ -z "${scripts[0]:-}" ]; then
            printf 'No Bash/sh product sources found\n' >&2
            exit 1
          fi
          mise exec aqua:koalaman/shellcheck@0.11.0 -- shellcheck --severity=style "${scripts[@]}"
          mise exec aqua:mvdan/sh@3.14.1 -- shfmt -d -i 2 "${scripts[@]}"
      - name: Bats real CLI behavior
        run: mise exec aqua:bats-core/bats-core@1.14.0 -- bats --tap [[ shell_tests | tojson ]]
{% endif %}
  security:
    name: Source and supply-chain safety
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false
          fetch-depth: 0
      - uses: jdx/mise-action@dba19683ed58901619b14f395a24841710cb4925 # v4.1.0
        with:
          install: false
{% if react or node %}
      - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4
        with:
          run_install: false
          package_json_file: [[ (js_workspace ~ "/package.json") | tojson ]]
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6
        with:
          node-version: [[ node_version | tojson ]]
          cache: pnpm
          cache-dependency-path: [[ (js_workspace ~ "/pnpm-lock.yaml") | tojson ]]
      - name: Install locked JavaScript dependencies for license audit
        working-directory: [[ js_workspace | tojson ]]
        run: pnpm install --frozen-lockfile
{% endif %}
{% if python %}
      - uses: astral-sh/setup-uv@37802adc94f370d6bfd71619e3f0bf239e1f3b78 # v7
        with:
          version: "0.13.8"
      - name: Install locked Python dependencies for license audit
        working-directory: [[ python_root | tojson ]]
        run: uv sync --locked --dev
      - name: Inventory installed Python dependency licenses
        working-directory: [[ python_root | tojson ]]
        run: |
          uv run --locked pip-licenses --format=json --output-file rill-python-licenses.json
          test -s rill-python-licenses.json
      - name: Block prohibited Python license families
        working-directory: [[ python_root | tojson ]]
        run: uv run --locked pip-licenses --partial-match --fail-on "GPL;AGPL;GNU General Public License;GNU Affero General Public License"
{% endif %}
      - name: Git history secret scan
        run: mise exec aqua:gitleaks/gitleaks@8.30.1 -- gitleaks git --redact --exit-code 1
      - name: Dependency and configuration vulnerability scan
        run: mise exec aqua:aquasecurity/trivy@0.76.2 -- trivy fs --scanners vuln,secret,misconfig --exit-code 1 --skip-dirs node_modules --skip-dirs .venv .
      - name: Block forbidden or restricted licenses
        run: mise exec aqua:aquasecurity/trivy@0.76.2 -- trivy fs --scanners license --include-dev-deps --severity HIGH,CRITICAL --exit-code 1 --skip-dirs .venv .
      - name: Record complete license classifications, including unknown
        run: mise exec aqua:aquasecurity/trivy@0.76.2 -- trivy fs --scanners license --include-dev-deps --format json --output rill-license-classifications.json --skip-dirs .venv .
      - name: Generate CycloneDX software bill of materials
        run: mise exec aqua:aquasecurity/trivy@0.76.2 -- trivy fs --include-dev-deps --format cyclonedx --output rill-sbom.cdx.json --skip-dirs node_modules --skip-dirs .venv .
      - name: Validate supply-chain evidence files
        run: |
          test -s rill-license-classifications.json
          test -s rill-sbom.cdx.json
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: rill-supply-chain-evidence
          path: |
            rill-sbom.cdx.json
            rill-license-classifications.json
{% if python %}
            [[ python_root ]]/rill-python-licenses.json
{% endif %}
          if-no-files-found: error
          retention-days: 14
