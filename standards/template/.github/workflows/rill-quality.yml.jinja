name: Rill Quality

on:
  pull_request:
    paths-ignore:
      - '**.md'
  push:
    branches: [main]

concurrency:
  group: rill-quality-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  quality:
    name: Lightweight quality checks
    if: github.event_name != 'pull_request' || github.event.pull_request.draft == false
    runs-on: ubuntu-latest
    env:
      CI: 'true'
      PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD: '1'
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false
      - uses: jdx/mise-action@dba19683ed58901619b14f395a24841710cb4925 # v4.1.0
        with:
          install_args: just@1.59.0
          cache: true
          cache_save_post: true
{% if react or node %}
      - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4
        with:
          version: 12
          run_install: false
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6
        with:
          node-version: [[ node_version | tojson ]]
          cache: pnpm
          cache-dependency-path: [[ (js_workspace ~ "/pnpm-lock.yaml") | tojson ]]
{% endif %}
{% if python %}
      - uses: astral-sh/setup-uv@37802adc94f370d6bfd71619e3f0bf239e1f3b78 # v7
        with:
          enable-cache: true
          cache-dependency-glob: [[ (python_root ~ "/uv.lock") | tojson ]]
{% endif %}
      - name: Install unit and static-check dependencies without browsers
        run: just setup-ci
      - name: Run incremental L2 checks
        run: just ci
