name: Rill Quality

on:
  pull_request:
  merge_group:
  workflow_dispatch:

permissions:
  contents: read

jobs:
{% if react or node %}
  typescript:
    needs: security
    name: TypeScript application gates
    runs-on: ubuntu-24.04
    env:
      CI: "true"
      PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD: "1"
      PLAYWRIGHT_BROWSERS_PATH: /tmp/rill-no-downloaded-browsers-${{ github.run_id }}
    defaults:
      run:
        working-directory: [[ js_workspace | tojson ]]
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false
      - uses: jdx/mise-action@dba19683ed58901619b14f395a24841710cb4925 # v4.1.0
        with:
          install: false
      - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4
        with:
          run_install: false
          package_json_file: [[ (js_workspace ~ "/package.json") | tojson ]]
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6
        with:
          node-version: [[ node_version | tojson ]]
          cache: pnpm
          cache-dependency-path: [[ (js_workspace ~ "/pnpm-lock.yaml") | tojson ]]
      - name: Install frozen workspace dependencies
        run: pnpm install --frozen-lockfile
      - name: Verify install did not mutate tracked product source
        shell: bash
        run: |
          root=$(git rev-parse --show-toplevel)
          git -C "$root" diff --cached HEAD --exit-code -- .
          git -C "$root" diff --exit-code -- .
{% if react %}
      - name: Verify tracked React application and test source
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        shell: bash
        run: |
          test -f package.json
          inventory=$(mktemp)
          trap 'rm -f "$inventory"' EXIT
          git ls-files -z -- [[ react_sources | tojson ]] tests > "$inventory"
          source_count=0
          test_count=0
          unit_count=0
          integration_count=0
          while IFS= read -r -d '' file; do
            case "$file" in
              *.d.ts) continue ;;
              *.test.*|*.spec.*)
                case "$file" in
                  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                    test_count=$((test_count + 1))
                    case "$file" in
                      *integration*.test.*|*integration*.spec.*)
                        integration_count=$((integration_count + 1))
                        ;;
                      *)
                        unit_count=$((unit_count + 1))
                        ;;
                    esac
                    ;;
                esac
                ;;
              tests/*|*/tests/*) continue ;;
              *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                source_count=$((source_count + 1))
                ;;
            esac
          done < "$inventory"
          test "$source_count" -gt 0
          test "$unit_count" -gt 0
          test "$integration_count" -gt 0
      - name: Execute native Vitest source coverage
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        shell: bash
        run: |
          reports=$(mktemp -d)
          inventory=$(mktemp)
          trap 'rm -rf "$reports"; rm -f "$inventory"' EXIT
          pnpm exec vitest run --coverage --coverage.include=[[ (react_sources ~ "/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}") | tojson ]] --coverage.exclude='**/*.d.ts' --coverage.thresholds.statements=[[ react_coverage ]] --coverage.reporter=json --coverage.reportsDirectory="$reports"
          test -s "$reports/coverage-final.json"
          git ls-files -z -- [[ react_sources | tojson ]] > "$inventory"
          examined=0
          while IFS= read -r -d '' source; do
            case "$source" in
              *.d.ts|*.test.*|*.spec.*) continue ;;
              *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                examined=$((examined + 1))
                jq -e --arg source "$PWD/$source" --argjson minimum [[ react_coverage ]] '
                  .[$source] as $entry |
                  if $entry == null or ($entry.s | type) != "object" then false
                  elif ($entry.s | length) == 0 then true
                  else ([$entry.s[] | select(. > 0)] | length) * 100 >= ($entry.s | length) * $minimum
                  end
                ' "$reports/coverage-final.json" >/dev/null
                ;;
            esac
          done < "$inventory"
          test "$examined" -gt 0
      - name: Execute actual React unit/component tests
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        shell: bash
        run: |
          inventory=$(mktemp)
          report=$(mktemp --suffix=.json)
          native_tests=$(mktemp --suffix=.json)
          browser_tests=$(mktemp --suffix=.json)
          trap 'rm -f "$inventory" "$report" "$native_tests" "$browser_tests"' EXIT
          pnpm exec vitest list --filesOnly --json > "$native_tests"
          pnpm exec playwright test --list --project=chrome --reporter=json | jq '[.config.rootDir as $root | .suites[] | recurse(.suites[]?) | .specs[]? | ($root + "/" + .file)] | unique' > "$browser_tests"
          jq -e 'type == "array"' "$native_tests" >/dev/null
          jq -e 'type == "array"' "$browser_tests" >/dev/null
          git ls-files -z -- [[ react_sources | tojson ]] tests > "$inventory"
          unit=()
          while IFS= read -r -d '' file; do
            case "$file" in
              *.test.*|*.spec.*) ;;
              *) continue ;;
            esac
            absolute=$(realpath -- "$file")
            if jq -e --arg file "$absolute" 'any(.[]; . == $file)' "$browser_tests" >/dev/null; then continue; fi
            jq -e --arg file "$absolute" 'any(.[]; .file == $file)' "$native_tests" >/dev/null || { echo "Tracked React test missing from native Vitest and Playwright discovery: $file" >&2; exit 1; }
            case "$file" in
              *integration*.test.*|*integration*.spec.*) continue ;;
              *.test.*|*.spec.*)
                case "$file" in
                  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                    unit+=("$file")
                    ;;
                esac
                ;;
            esac
          done < "$inventory"
          test -n "${unit[0]:-}"
          pnpm exec vitest run --reporter=json --outputFile="$report" "${unit[@]}"
          test -s "$report"
          for file in "${unit[@]}"; do
            jq -e --arg expected "$(realpath -- "$file")" '
              .numPassedTests > 0 and
              any(.testResults[]?;
                .name == $expected and .status == "passed" and
                any(.assertionResults[]?; .status == "passed")
              )
            ' "$report" >/dev/null
          done
      - name: Execute actual React integration tests
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        shell: bash
        run: |
          inventory=$(mktemp)
          report=$(mktemp --suffix=.json)
          native_tests=$(mktemp --suffix=.json)
          browser_tests=$(mktemp --suffix=.json)
          trap 'rm -f "$inventory" "$report" "$native_tests" "$browser_tests"' EXIT
          pnpm exec vitest list --filesOnly --json > "$native_tests"
          pnpm exec playwright test --list --project=chrome --reporter=json | jq '[.config.rootDir as $root | .suites[] | recurse(.suites[]?) | .specs[]? | ($root + "/" + .file)] | unique' > "$browser_tests"
          jq -e 'type == "array"' "$native_tests" >/dev/null
          jq -e 'type == "array"' "$browser_tests" >/dev/null
          git ls-files -z -- [[ react_sources | tojson ]] tests > "$inventory"
          integration=()
          while IFS= read -r -d '' file; do
            case "$file" in
              *.test.*|*.spec.*) ;;
              *) continue ;;
            esac
            absolute=$(realpath -- "$file")
            if jq -e --arg file "$absolute" 'any(.[]; . == $file)' "$browser_tests" >/dev/null; then continue; fi
            jq -e --arg file "$absolute" 'any(.[]; .file == $file)' "$native_tests" >/dev/null || { echo "Tracked React test missing from native Vitest and Playwright discovery: $file" >&2; exit 1; }
            case "$file" in
              *integration*.test.*|*integration*.spec.*)
                case "$file" in
                  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                    integration+=("$file")
                    ;;
                esac
                ;;
            esac
          done < "$inventory"
          test -n "${integration[0]:-}"
          pnpm exec vitest run --reporter=json --outputFile="$report" "${integration[@]}"
          test -s "$report"
          for file in "${integration[@]}"; do
            jq -e --arg expected "$(realpath -- "$file")" '
              .numPassedTests > 0 and
              any(.testResults[]?;
                .name == $expected and .status == "passed" and
                any(.assertionResults[]?; .status == "passed")
              )
            ' "$report" >/dev/null
          done
      - name: Verify actual product in system Chrome with axe-core
        id: rill_product_proof
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        shell: bash
        run: |
          test -n "$(git grep -l -F -- '@axe-core/playwright' -- '*.js' '*.mjs' '*.cjs' '*.ts' '*.mts' '*.cts' '*.jsx' '*.tsx' || true)"
          test -n "$(git grep -l -F -- '.analyze(' -- '*.js' '*.mjs' '*.cjs' '*.ts' '*.mts' '*.cts' '*.jsx' '*.tsx' || true)"
          target=$(pnpm exec playwright test --list --project=chrome --reporter=json | jq -er '.config.configFile')
          proof=$(mktemp -d .rill-browser-XXXXXXXX)
          config=$(mktemp --suffix=.mjs .rill-playwright-XXXXXXXX)
          trap 'rm -rf "$proof"; rm -f "$config"' EXIT
          # Keep the config beside the target so relative setup and webServer paths still resolve.
          printf 'import target from "./%s";\n' "$(basename "$target")" > "$config"
          cat >> "$config" <<'BROWSER_CONFIG'
          import { defineConfig } from "@playwright/test";

          const adopted = target.default ?? target;
          export default defineConfig({
            ...adopted,
            projects: adopted.projects.map((project) =>
              project.name === "chrome"
                ? {
                    ...project,
                    testDir: process.env.RILL_BROWSER_PROOF_DIR,
                    testMatch: "**/proof.mjs",
                    testIgnore: [],
                    grepInvert: [],
                  }
                : project,
            ),
          });
          BROWSER_CONFIG
          cat > "$proof/proof.mjs" <<'BROWSER'
          import AxeBuilder from "@axe-core/playwright";
          import { appendFileSync } from "node:fs";
          import { expect, test } from "@playwright/test";

          test("@rill-product-chrome-axe-proof", async ({ page, baseURL }, testInfo) => {
            expect(testInfo.project.use.channel).toBe("chrome");
            expect(baseURL, "Set baseURL to the product page to scan").toMatch(/^https?:\/\//);
            const response = await page.goto(baseURL);
            expect(response?.ok(), `Product page returned HTTP ${response?.status()}`).toBe(true);
            const report = await new AxeBuilder({ page })
              .withTags(["wcag2a", "wcag2aa", "wcag21a", "wcag21aa"])
              .analyze();
            expect(report.violations).toEqual([]);
            expect(page.url(), "Product redirect must match the explicit approved URL").toBe(
              new URL(process.env.RILL_ALLOWED_PRODUCT_URL ?? baseURL).href,
            );
            if (process.env.GITHUB_OUTPUT) {
              appendFileSync(process.env.GITHUB_OUTPUT, `product_url=${page.url()}\n`);
            }
          });
          BROWSER
          RILL_BROWSER_PROOF_DIR="$PWD/$proof" pnpm exec playwright test --config="$config" --project=chrome --grep '@rill-product-chrome-axe-proof' --repeat-each=1 --output="$proof/results" --reporter=json > "$proof/report.json" || { cat "$proof/report.json"; exit 1; }
          jq -e '[.suites[] | recurse(.suites[]?) | .specs[]? | select(.title == "@rill-product-chrome-axe-proof") | .tests[]? | select(.projectName == "chrome") | .results[]? | select(.status == "passed")] | length == 1' "$proof/report.json"
{% for tag, label in [("e2e", "E2E"), ("a11y", "accessibility")] %}
      - name: Execute native Chrome [[ label ]] test cases
        env:
          RILL_PRODUCT_URL: ${{ steps.rill_product_proof.outputs.product_url }}
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        shell: bash
        run: |
          traces=$(mktemp -d)
          trap 'rm -rf "$traces"' EXIT
          pnpm exec playwright test --project=chrome --grep '@[[ tag ]]' --trace on --output="$traces/results" --reporter=json > "$traces/report.json" || { cat "$traces/report.json"; exit 1; }
          jq -r '
            .suites[] | recurse(.suites[]?) | .specs[]?.tests[]?
            | select(.projectName == "chrome") | .results[]?
            | select(.status == "passed") | .attachments[]?
            | select(.name == "trace" and .path != null) | .path
          ' "$traces/report.json" > "$traces/passed-traces"
          test -n "$RILL_PRODUCT_URL"
          python3 - "$traces/passed-traces" "$RILL_PRODUCT_URL" <<'TRACE'
          import json
          from pathlib import Path
          import sys
          from zipfile import ZipFile
          from urllib.parse import urlsplit

          product = urlsplit(sys.argv[2])
          if product.scheme not in ("http", "https") or not product.netloc:
              sys.exit("No valid product URL from successful Chrome/axe proof")

          def visited_page(path):
              with ZipFile(path) as archive:
                  for name in archive.namelist():
                      if not name.endswith(".trace"):
                          continue
                      with archive.open(name) as events:
                          for line in events:
                              event = json.loads(line)
                              if event.get("type") != "frame-snapshot":
                                  continue
                              frame = event["snapshot"]
                              url = urlsplit(frame["frameUrl"])
                              product_path = product.path.rstrip("/")
                              on_product = url.path == (product.path or "/") or url.path.startswith(product_path + "/")
                              if (frame["isMainFrame"] and url.scheme == product.scheme
                                      and url.netloc == product.netloc and on_product):
                                  return True
              return False

          if not any(visited_page(path) for path in Path(sys.argv[1]).read_text().splitlines()):
              sys.exit("No passing Chrome test recorded the product page")
          TRACE
{% endfor %}

      - name: React security and correctness lint with Oxlint
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        run: mise exec aqua:oxc-project/oxc/oxlint@1.94.0 -- oxlint -D correctness -D complexity --deny-warnings [[ react_sources | tojson ]]
      - name: React source complexity with Lizard
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        shell: bash
        run: |
          inventory=$(mktemp)
          trap 'rm -f "$inventory"' EXIT
          git ls-files -z -- [[ react_sources | tojson ]] > "$inventory"
          sources=()
          while IFS= read -r -d '' file; do
            case "$file" in
              *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs|*.mts|*.cts)
                sources+=("$file")
                ;;
            esac
          done < "$inventory"
          test -n "${sources[0]:-}"
          mise exec pypi:lizard@1.26.1 -- lizard -l typescript -l tsx -l javascript -i 0 "${sources[@]}"
      - name: React source lint with Biome
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        run: pnpm exec biome check [[ react_sources | tojson ]]
      - name: React TypeScript and public contracts
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        run: pnpm exec tsc --noEmit
      - name: React production build
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        shell: bash
        run: |
          artifact=[[ react_build_artifact | tojson ]]
          rm -f -- "$artifact"
          pnpm run build
          test -f "$artifact"
          test -s "$artifact"
{% endif %}
{% if node %}
