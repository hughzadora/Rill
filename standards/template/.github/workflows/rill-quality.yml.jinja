      - name: Execute native Vitest source coverage for Node
        working-directory: [[ (js_workspace ~ "/" ~ node_root) | tojson ]]
        shell: bash
        run: |
          reports=$(mktemp -d)
          inventory=$(mktemp)
          trap 'rm -rf "$reports"; rm -f "$inventory"' EXIT
          pnpm exec vitest run --coverage --coverage.include=[[ (node_sources ~ "/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}") | tojson ]] --coverage.exclude='**/*.d.ts' --coverage.thresholds.statements=[[ node_coverage ]] --coverage.reporter=json --coverage.reportsDirectory="$reports"
          test -s "$reports/coverage-final.json"
          git ls-files -z -- [[ node_sources | tojson ]] > "$inventory"
          examined=0
          while IFS= read -r -d '' source; do
            case "$source" in
              *.d.ts|*.test.*|*.spec.*) continue ;;
              *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                examined=$((examined + 1))
                jq -e --arg source "$PWD/$source" --argjson minimum [[ node_coverage ]] '
