name: Rill Quality

on:
  pull_request:
  merge_group:
  workflow_dispatch:

permissions:
  contents: read

jobs:
{% if react or node %}
  typescript:
    needs: security
    name: TypeScript application gates
    runs-on: ubuntu-24.04
    env:
      CI: "true"
      PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD: "1"
      PLAYWRIGHT_BROWSERS_PATH: /tmp/rill-no-downloaded-browsers-${{ github.run_id }}
    defaults:
      run:
        working-directory: [[ js_workspace | tojson ]]
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false
      - uses: jdx/mise-action@dba19683ed58901619b14f395a24841710cb4925 # v4.1.0
        with:
          install: false
      - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4
        with:
          run_install: false
          package_json_file: [[ (js_workspace ~ "/package.json") | tojson ]]
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6
        with:
          node-version: [[ node_version | tojson ]]
          cache: pnpm
          cache-dependency-path: [[ (js_workspace ~ "/pnpm-lock.yaml") | tojson ]]
      - name: Install frozen workspace dependencies
        run: pnpm install --frozen-lockfile
      - name: Verify install did not mutate tracked product source
        shell: bash
        run: |
          root=$(git rev-parse --show-toplevel)
          git -C "$root" diff --cached HEAD --exit-code -- .
          git -C "$root" diff --exit-code -- .
{% if react %}
      - name: Verify tracked React application and test source
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        shell: bash
        run: |
          test -f package.json
          inventory=$(mktemp)
          trap 'rm -f "$inventory"' EXIT
          git ls-files -z -- [[ react_sources | tojson ]] tests > "$inventory"
          source_count=0
          test_count=0
          integration_count=0
          while IFS= read -r -d '' file; do
            case "$file" in
              *.d.ts) continue ;;
              *.test.*|*.spec.*)
                case "$file" in
                  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                    test_count=$((test_count + 1))
                    case "$file" in
                      *integration*.test.*|*integration*.spec.*)
                        integration_count=$((integration_count + 1))
                        ;;
                    esac
                    ;;
                esac
                ;;
              *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                source_count=$((source_count + 1))
                ;;
            esac
          done < "$inventory"
          test "$source_count" -gt 0
          test "$test_count" -gt 0
          test "$integration_count" -gt 0
      - name: Execute native Vitest source coverage
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        shell: bash
        run: |
          reports=$(mktemp -d)
          inventory=$(mktemp)
          trap 'rm -rf "$reports"; rm -f "$inventory"' EXIT
          pnpm exec vitest run --coverage --coverage.include=[[ (react_sources ~ "/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}") | tojson ]] --coverage.exclude='**/*.d.ts' --coverage.thresholds.statements=[[ react_coverage ]] --coverage.reporter=json --coverage.reportsDirectory="$reports"
          test -s "$reports/coverage-final.json"
          git ls-files -z -- [[ react_sources | tojson ]] > "$inventory"
          examined=0
          while IFS= read -r -d '' source; do
            case "$source" in
              *.d.ts|*.test.*|*.spec.*) continue ;;
              *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                examined=$((examined + 1))
                jq -e --arg source "$PWD/$source" --argjson minimum [[ react_coverage ]] '
                  .[$source] as $entry |
                  if $entry == null or ($entry.s | type) != "object" then false
                  elif ($entry.s | length) == 0 then true
                  else ([$entry.s[] | select(. > 0)] | length) * 100 >= ($entry.s | length) * $minimum
                  end
                ' "$reports/coverage-final.json" >/dev/null
                ;;
            esac
          done < "$inventory"
          test "$examined" -gt 0
      - name: Execute actual React integration tests
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        shell: bash
        run: |
          inventory=$(mktemp)
          report=$(mktemp --suffix=.json)
          trap 'rm -f "$inventory" "$report"' EXIT
          git ls-files -z -- [[ react_sources | tojson ]] tests > "$inventory"
          integration=()
          while IFS= read -r -d '' file; do
            case "$file" in
              *integration*.test.*|*integration*.spec.*)
                case "$file" in
                  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                    integration+=("$file")
                    ;;
                esac
                ;;
            esac
          done < "$inventory"
          test -n "${integration[0]:-}"
          pnpm exec vitest run --reporter=json --outputFile="$report" "${integration[@]}"
          test -s "$report"
          for file in "${integration[@]}"; do
            jq -e --arg expected "$(realpath -- "$file")" '
              .numPassedTests > 0 and
              any(.testResults[]?;
                .name == $expected and .status == "passed" and
                any(.assertionResults[]?; .status == "passed")
              )
            ' "$report" >/dev/null
          done
      - name: Verify system Google Chrome
        run: google-chrome --version || google-chrome-stable --version
      - name: Execute native Chrome E2E test cases
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        shell: bash
        run: |
          report=$(mktemp --suffix=.json)
          trap 'rm -f "$report"' EXIT
          pnpm exec playwright test --project=chrome --grep '@e2e' --reporter=json > "$report"
          jq -e '[.suites[] | recurse(.suites[]?) | .specs[]?.tests[]?.results[]? | select(.status == "passed")] | length > 0' "$report"
      - name: Execute native Chrome accessibility test cases
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        shell: bash
        run: |
          report=$(mktemp --suffix=.json)
          trap 'rm -f "$report"' EXIT
          pnpm exec playwright test --project=chrome --grep '@a11y' --reporter=json > "$report"
          jq -e '[.suites[] | recurse(.suites[]?) | .specs[]?.tests[]?.results[]? | select(.status == "passed")] | length > 0' "$report"

      - name: React security and correctness lint with Oxlint
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        run: mise exec aqua:oxc-project/oxc/oxlint@1.94.0 -- oxlint -D correctness -D complexity --deny-warnings [[ react_sources | tojson ]]
      - name: React source complexity with Lizard
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        shell: bash
        run: |
          inventory=$(mktemp)
          trap 'rm -f "$inventory"' EXIT
          git ls-files -z -- [[ react_sources | tojson ]] > "$inventory"
          sources=()
          while IFS= read -r -d '' file; do
            case "$file" in
              *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs|*.mts|*.cts)
                sources+=("$file")
                ;;
            esac
          done < "$inventory"
          test -n "${sources[0]:-}"
          mise exec pypi:lizard@1.26.1 -- lizard -l typescript -l tsx -l javascript -i 0 "${sources[@]}"
      - name: React source lint with Biome
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        run: pnpm exec biome check [[ react_sources | tojson ]]
      - name: React TypeScript and public contracts
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        run: pnpm exec tsc --noEmit
      - name: React production build
        working-directory: [[ (js_workspace ~ "/" ~ react_root) | tojson ]]
        shell: bash
        run: |
          artifact=[[ react_build_artifact | tojson ]]
          rm -f -- "$artifact"
          pnpm run build
          test -f "$artifact"
          test -s "$artifact"
{% endif %}
{% if node %}
      - name: Verify tracked Node application and test source
        working-directory: [[ (js_workspace ~ "/" ~ node_root) | tojson ]]
        shell: bash
        run: |
          test -f package.json
          inventory=$(mktemp)
          trap 'rm -f "$inventory"' EXIT
          git ls-files -z -- [[ node_sources | tojson ]] tests > "$inventory"
          source_count=0
          test_count=0
          integration_count=0
          while IFS= read -r -d '' file; do
            case "$file" in
              *.d.ts) continue ;;
              *.test.*|*.spec.*)
                case "$file" in
                  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                    test_count=$((test_count + 1))
                    case "$file" in
                      *integration*.test.*|*integration*.spec.*)
                        integration_count=$((integration_count + 1))
                        ;;
                    esac
                    ;;
                esac
                ;;
              *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                source_count=$((source_count + 1))
                ;;
            esac
          done < "$inventory"
          test "$source_count" -gt 0
          test "$test_count" -gt 0
          test "$integration_count" -gt 0
{% if node_test_runner == "node" %}
      - name: Execute native Node test runner with full-source coverage
        working-directory: [[ (js_workspace ~ "/" ~ node_root) | tojson ]]
        shell: bash
        run: |
          policy=$(mktemp --suffix=.json)
          trap 'rm -f "$policy"' EXIT
          printf '{}\n' > "$policy"
          pnpm exec c8 --config "$policy" --all --src [[ node_sources | tojson ]] --include [[ (node_sources ~ "/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}") | tojson ]] --extension .ts --extension .tsx --extension .js --extension .jsx --extension .mjs --extension .cjs --extension .mts --extension .cts --check-coverage --per-file --lines=[[ node_coverage ]] node --experimental-strip-types --test
      - name: Execute actual Node integration tests
        working-directory: [[ (js_workspace ~ "/" ~ node_root) | tojson ]]
        shell: bash
        run: |
          inventory=$(mktemp)
          report=$(mktemp)
          trap 'rm -f "$inventory" "$report"' EXIT
          git ls-files -z -- [[ node_sources | tojson ]] tests > "$inventory"
          integration=()
          while IFS= read -r -d '' file; do
            case "$file" in
              *integration*.test.*|*integration*.spec.*)
                case "$file" in
                  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                    integration+=("$file")
                    ;;
                esac
                ;;
            esac
          done < "$inventory"
          test -n "${integration[0]:-}"
          for file in "${integration[@]}"; do
            node --experimental-strip-types --test --test-reporter=tap "$file" > "$report"
            grep -Eq '^# pass [1-9][0-9]*$' "$report"
            if grep -Eq '^# Subtest: .*/[^/]+\.(test|spec)\.(js|jsx|ts|tsx|mjs|cjs|mts|cts)$' "$report"; then
              printf 'No registered test case in %s\n' "$file" >&2
              exit 1
            fi
          done
{% else %}
      - name: Execute native Vitest source coverage for Node
        working-directory: [[ (js_workspace ~ "/" ~ node_root) | tojson ]]
        shell: bash
        run: |
          reports=$(mktemp -d)
          inventory=$(mktemp)
          trap 'rm -rf "$reports"; rm -f "$inventory"' EXIT
          pnpm exec vitest run --coverage --coverage.include=[[ (node_sources ~ "/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}") | tojson ]] --coverage.exclude='**/*.d.ts' --coverage.thresholds.statements=[[ node_coverage ]] --coverage.reporter=json --coverage.reportsDirectory="$reports"
          test -s "$reports/coverage-final.json"
          git ls-files -z -- [[ node_sources | tojson ]] > "$inventory"
          examined=0
          while IFS= read -r -d '' source; do
            case "$source" in
              *.d.ts|*.test.*|*.spec.*) continue ;;
              *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                examined=$((examined + 1))
                jq -e --arg source "$PWD/$source" --argjson minimum [[ node_coverage ]] '
                  .[$source] as $entry |
                  if $entry == null or ($entry.s | type) != "object" then false
                  elif ($entry.s | length) == 0 then true
                  else ([$entry.s[] | select(. > 0)] | length) * 100 >= ($entry.s | length) * $minimum
                  end
                ' "$reports/coverage-final.json" >/dev/null
                ;;
            esac
          done < "$inventory"
          test "$examined" -gt 0
      - name: Execute actual Node integration tests
        working-directory: [[ (js_workspace ~ "/" ~ node_root) | tojson ]]
        shell: bash
        run: |
          inventory=$(mktemp)
          report=$(mktemp --suffix=.json)
          trap 'rm -f "$inventory" "$report"' EXIT
          git ls-files -z -- [[ node_sources | tojson ]] tests > "$inventory"
          integration=()
          while IFS= read -r -d '' file; do
            case "$file" in
              *integration*.test.*|*integration*.spec.*)
                case "$file" in
                  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                    integration+=("$file")
                    ;;
                esac
                ;;
            esac
          done < "$inventory"
          test -n "${integration[0]:-}"
          pnpm exec vitest run --reporter=json --outputFile="$report" "${integration[@]}"
          test -s "$report"
          for file in "${integration[@]}"; do
            jq -e --arg expected "$(realpath -- "$file")" '
              .numPassedTests > 0 and
              any(.testResults[]?;
                .name == $expected and .status == "passed" and
                any(.assertionResults[]?; .status == "passed")
              )
            ' "$report" >/dev/null
          done
{% endif %}
      - name: Node security and correctness lint with Oxlint
        working-directory: [[ (js_workspace ~ "/" ~ node_root) | tojson ]]
        run: mise exec aqua:oxc-project/oxc/oxlint@1.94.0 -- oxlint -D correctness -D complexity --deny-warnings [[ node_sources | tojson ]]
      - name: Node source complexity with Lizard
        working-directory: [[ (js_workspace ~ "/" ~ node_root) | tojson ]]
        shell: bash
        run: |
          inventory=$(mktemp)
          trap 'rm -f "$inventory"' EXIT
          git ls-files -z -- [[ node_sources | tojson ]] > "$inventory"
          sources=()
          while IFS= read -r -d '' file; do
            case "$file" in
              *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs|*.mts|*.cts)
                sources+=("$file")
                ;;
            esac
          done < "$inventory"
          test -n "${sources[0]:-}"
          mise exec pypi:lizard@1.26.1 -- lizard -l typescript -l tsx -l javascript -i 0 "${sources[@]}"
      - name: Node source lint with Biome
        working-directory: [[ (js_workspace ~ "/" ~ node_root) | tojson ]]
        run: pnpm exec biome check [[ node_sources | tojson ]]
      - name: Node TypeScript and contracts
        working-directory: [[ (js_workspace ~ "/" ~ node_root) | tojson ]]
        run: pnpm exec tsc --noEmit
      - name: Node production build
        working-directory: [[ (js_workspace ~ "/" ~ node_root) | tojson ]]
        shell: bash
        run: |
          artifact=[[ node_build_artifact | tojson ]]
          rm -f -- "$artifact"
          pnpm run build
          test -f "$artifact"
          test -s "$artifact"
{% endif %}
      - name: Audit production Node dependencies
        run: pnpm audit
{% endif %}
{% if python %}
  python:
    needs: security
    name: Python application gates
    runs-on: ubuntu-24.04
    defaults:
      run:
        working-directory: [[ python_root | tojson ]]
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@37802adc94f370d6bfd71619e3f0bf239e1f3b78 # v7
        with:
          version: "0.13.8"
      - name: Install frozen Python project
        run: uv sync --locked --dev
      - name: Ruff lint
        run: uv run --locked ruff check [[ python_sources | tojson ]] [[ python_tests | tojson ]]
      - name: Ruff format
        run: uv run --locked ruff format --check [[ python_sources | tojson ]] [[ python_tests | tojson ]]
      - name: Python static types
        run: uv run --locked mypy --strict [[ python_sources | tojson ]]
      - name: Python unit/regression and coverage
        run: uv run --locked pytest -q --cov=[[ python_sources | tojson ]] --cov-report=term-missing --cov-fail-under=[[ python_coverage ]] [[ python_tests | tojson ]]
      - name: Python real integration
        run: uv run --locked pytest -q [[ python_integration | tojson ]]
      - name: Python package build
        run: uv build --no-build-isolation
{% endif %}
{% if shell %}
  shell:
    needs: security
    name: Shell source and CLI behavior
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false
      - uses: jdx/mise-action@dba19683ed58901619b14f395a24841710cb4925 # v4.1.0
        with:
          install: false
      - name: Shell source static analysis
        shell: bash
        run: |
          scripts=()
          while IFS= read -r -d '' source; do
            case "$source" in
              *.sh) scripts+=("$source"); continue ;;
            esac
            words=()
            read -r -a words < "$source" || true
            case "${words[0]:-}" in
              '#!'*/bash|'#!'*/sh)
                scripts+=("$source")
                ;;
              '#!'*/env)
                for arg in "${words[@]:1}"; do
                  case "$arg" in
                    bash|sh) scripts+=("$source"); break ;;
                    -*|*=*) continue ;;
                    *) break ;;
                  esac
                done
                ;;
            esac
          done < <(find [[ shell_sources | tojson ]] -type f -print0)
          if [ -z "${scripts[0]:-}" ]; then
            printf 'No Bash/sh product sources found\n' >&2
            exit 1
          fi
          mise exec aqua:koalaman/shellcheck@0.11.0 -- shellcheck --severity=style "${scripts[@]}"
          mise exec aqua:mvdan/sh@3.14.1 -- shfmt -d -i 2 "${scripts[@]}"
      - name: Bats real CLI behavior
        run: mise exec aqua:bats-core/bats-core@1.14.0 -- bats --tap [[ shell_tests | tojson ]]
{% endif %}
  security:
    name: Source and supply-chain safety
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false
          fetch-depth: 0
      - uses: jdx/mise-action@dba19683ed58901619b14f395a24841710cb4925 # v4.1.0
        with:
          install: false
      - name: Scan committed Git history before dependency installation
        shell: bash
        run: |
          neutral=$(mktemp -d)
          trap 'rmdir "$neutral"' EXIT
          checkout="$GITHUB_WORKSPACE"
          (
            cd "$neutral"
            unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML
            GIT_DIR="$checkout/.git" GIT_WORK_TREE="$checkout" mise exec aqua:gitleaks/gitleaks@8.30.1 -- gitleaks git --gitleaks-ignore-path=/dev/null --ignore-gitleaks-allow --redact --exit-code 1
          )
      - name: Scan original source and lockfiles before dependency installation
        run: mise exec aqua:aquasecurity/trivy@0.76.2 -- trivy fs --config="" --ignorefile="" --secret-config="" --scanners vuln,secret,misconfig --include-dev-deps --exit-code 1 --skip-dirs node_modules --skip-dirs .venv .
{% if react or node %}
      - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4
        with:
          run_install: false
          package_json_file: [[ (js_workspace ~ "/package.json") | tojson ]]
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6
        with:
          node-version: [[ node_version | tojson ]]
          cache: pnpm
          cache-dependency-path: [[ (js_workspace ~ "/pnpm-lock.yaml") | tojson ]]
      - name: Install locked JavaScript dependencies for license audit
        working-directory: [[ js_workspace | tojson ]]
        run: pnpm install --frozen-lockfile
{% endif %}
{% if python %}
      - uses: astral-sh/setup-uv@37802adc94f370d6bfd71619e3f0bf239e1f3b78 # v7
        with:
          version: "0.13.8"
      - name: Install locked Python dependencies for license audit
        working-directory: [[ python_root | tojson ]]
        run: uv sync --locked --dev
      - name: Inventory installed Python dependency licenses
        working-directory: [[ python_root | tojson ]]
        run: |
          uv run --locked pip-licenses --format=json --output-file rill-python-licenses.json
          test -s rill-python-licenses.json
{% endif %}
      - name: Verify supply-chain installs preserved tracked source
        shell: bash
        run: |
          root=$(git rev-parse --show-toplevel)
          git -C "$root" diff --cached HEAD --exit-code -- .
          git -C "$root" diff --exit-code -- .
      - name: Record complete license classifications, including unknown
        run: mise exec aqua:aquasecurity/trivy@0.76.2 -- trivy fs --config="" --ignorefile="" --secret-config="" --scanners license --include-dev-deps --format json --output rill-license-classifications.json --skip-dirs .venv .
      - name: Generate CycloneDX software bill of materials
        run: mise exec aqua:aquasecurity/trivy@0.76.2 -- trivy fs --config="" --ignorefile="" --secret-config="" --include-dev-deps --format cyclonedx --output rill-sbom.cdx.json --skip-dirs node_modules --skip-dirs .venv .
      - name: Validate supply-chain evidence files
        run: |
          test -s rill-license-classifications.json
          test -s rill-sbom.cdx.json
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: rill-supply-chain-evidence
          path: |
            rill-sbom.cdx.json
            rill-license-classifications.json
{% if python %}
            [[ python_root ]]/rill-python-licenses.json
{% endif %}
          if-no-files-found: error
          retention-days: 14
{% if python %}
      - name: Block prohibited Python license families
        working-directory: [[ python_root | tojson ]]
        run: uv run --locked pip-licenses --fail-on "GPL;AGPL;GPL-2.0;GPL-2.0-only;GPL-2.0-or-later;GPL-3.0;GPL-3.0-only;GPL-3.0-or-later;AGPL-3.0;AGPL-3.0-only;AGPL-3.0-or-later;GNU General Public License;GNU Affero General Public License"
{% endif %}
      - name: Block forbidden or restricted license classifications
        run: mise exec aqua:aquasecurity/trivy@0.76.2 -- trivy fs --config="" --ignorefile="" --secret-config="" --scanners license --include-dev-deps --severity HIGH,CRITICAL --exit-code 1 --skip-dirs .venv .
