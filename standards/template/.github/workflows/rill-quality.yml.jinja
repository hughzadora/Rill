        run: |
          test -f package.json
          inventory=$(mktemp)
          trap 'rm -f "$inventory"' EXIT
          git ls-files -z -- [[ node_sources | tojson ]] tests > "$inventory"
          source_count=0
          test_count=0
          unit_count=0
          integration_count=0
          while IFS= read -r -d '' file; do
            case "$file" in
              *.d.ts) continue ;;
              *.test.*|*.spec.*)
                case "$file" in
                  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                    test_count=$((test_count + 1))
                    case "$file" in
                      *integration*.test.*|*integration*.spec.*)
                        integration_count=$((integration_count + 1))
                        ;;
                      *)
                        unit_count=$((unit_count + 1))
                        ;;
                    esac
                    ;;
                esac
                ;;
              tests/*|*/tests/*) continue ;;
              *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                source_count=$((source_count + 1))
                ;;
            esac
          done < "$inventory"
          test "$source_count" -gt 0
          test "$unit_count" -gt 0
          test "$integration_count" -gt 0
{% if node_test_runner == "node" %}
      - name: Execute native Node test runner with full-source coverage
        working-directory: [[ (js_workspace ~ "/" ~ node_root) | tojson ]]
        shell: bash
        run: |
          policy=$(mktemp --suffix=.json)
          inventory=$(mktemp)
          trap 'rm -f "$policy" "$inventory"' EXIT
          printf '{}\n' > "$policy"
          git ls-files -z -- [[ node_sources | tojson ]] tests > "$inventory"
          native_tests=()
          while IFS= read -r -d '' file; do
            case "$file" in
              *.test.*|*.spec.*)
                case "$file" in
                  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts) native_tests+=("$file") ;;
                esac
                ;;
            esac
          done < "$inventory"
          test -n "${native_tests[0]:-}"
          pnpm exec c8 --config "$policy" --all --src [[ node_sources | tojson ]] --include [[ (node_sources ~ "/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}") | tojson ]] --extension .ts --extension .tsx --extension .js --extension .jsx --extension .mjs --extension .cjs --extension .mts --extension .cts --check-coverage --per-file --lines=[[ node_coverage ]] bash -e -c 'node --experimental-strip-types --test && node --experimental-strip-types --test "$@"' rill-native-coverage "${native_tests[@]}"
      - name: Execute actual Node unit tests
        working-directory: [[ (js_workspace ~ "/" ~ node_root) | tojson ]]
        shell: bash
        run: |
          inventory=$(mktemp)
          report=$(mktemp)
          trap 'rm -f "$inventory" "$report"' EXIT
          git ls-files -z -- [[ node_sources | tojson ]] tests > "$inventory"
          unit=()
          while IFS= read -r -d '' file; do
            case "$file" in
              *integration*.test.*|*integration*.spec.*) continue ;;
              *.test.*|*.spec.*)
                case "$file" in
                  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                    unit+=("$file")
                    ;;
                esac
                ;;
            esac
          done < "$inventory"
          test -n "${unit[0]:-}"
          for file in "${unit[@]}"; do
            node --experimental-strip-types --test --test-reporter=junit "$file" > "$report"
            python3 - "$report" "$file" <<'PYTEST'
          from pathlib import Path
          from xml.etree import ElementTree
          import sys
          root = ElementTree.parse(sys.argv[1]).getroot()
          wrapper = str(Path(sys.argv[2]).resolve())
          relative_file = sys.argv[2]
          cases = root.findall(".//testcase")
          if not any(case.get("name") not in (wrapper, relative_file) and
                     not list(case.findall("failure")) and
                     not list(case.findall("skipped")) for case in cases):
              sys.exit("No passing registered unit test")
          PYTEST
          done
      - name: Execute actual Node integration tests
        working-directory: [[ (js_workspace ~ "/" ~ node_root) | tojson ]]
        shell: bash
        run: |
          inventory=$(mktemp)
          report=$(mktemp)
          trap 'rm -f "$inventory" "$report"' EXIT
          git ls-files -z -- [[ node_sources | tojson ]] tests > "$inventory"
          integration=()
          while IFS= read -r -d '' file; do
            case "$file" in
              *integration*.test.*|*integration*.spec.*)
                case "$file" in
                  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts)
                    integration+=("$file")
                    ;;
                esac
                ;;
            esac
          done < "$inventory"
          test -n "${integration[0]:-}"
          for file in "${integration[@]}"; do
            node --experimental-strip-types --test --test-reporter=junit "$file" > "$report"
            python3 - "$report" "$file" <<'PYTEST'
          from pathlib import Path
          from xml.etree import ElementTree
          import sys
          root = ElementTree.parse(sys.argv[1]).getroot()
          wrapper = str(Path(sys.argv[2]).resolve())
          relative_file = sys.argv[2]
          cases = root.findall(".//testcase")
          if not any(case.get("name") not in (wrapper, relative_file) and
                     not list(case.findall("failure")) and
                     not list(case.findall("skipped")) for case in cases):
              sys.exit("No passing registered integration test")
          PYTEST
          done
{% else %}
