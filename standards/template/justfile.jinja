set shell := ["bash", "-euo", "pipefail", "-c"]

# Rill L2 only: installs local dependencies without browser downloads.
setup-ci:
    mise install aqua:gitleaks/gitleaks@8.30.1
{% if react or node %}    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 pnpm --dir [[ js_workspace | tojson ]] install --frozen-lockfile
{% endif %}{% if python %}    uv --directory [[ python_root | tojson ]] sync --locked --dev
{% endif %}{% if shell %}    mise install aqua:koalaman/shellcheck@0.11.0 aqua:mvdan/sh@3.14.1 aqua:bats-core/bats-core@1.14.0
{% endif %}

ci:
    #!/usr/bin/env bash
    START_HEAD="$(git rev-parse HEAD)" || exit 1
    set -euo pipefail
    receipt() { if command -v rill >/dev/null 2>&1; then rill policy ci-receipt ci "$1" "$START_HEAD"; fi; }
    if [ "${CI:-}" = "true" ] && ! command -v rill >/dev/null 2>&1; then
      printf '%s\n' 'Rill CLI missing: install the pinned GitHub Release via mise before CI.' >&2
      exit 2
    fi
    if command -v rill >/dev/null 2>&1; then rill policy governance-check; fi
    if [ "${RILL_FULL:-0}" != "1" ]; then receipt running; fi
    neutral="$(mktemp -d)"; trap 'rmdir "$neutral"' EXIT; (cd "$neutral"; unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML; GIT_DIR="{{justfile_directory()}}/.git" GIT_WORK_TREE="{{justfile_directory()}}" mise exec aqua:gitleaks/gitleaks@8.30.1 -- gitleaks git --gitleaks-ignore-path=/dev/null --ignore-gitleaks-allow --redact --exit-code 1)
{% if react %}    pnpm --dir [[ (js_workspace ~ "/" ~ react_root) | tojson ]] run lint
    pnpm --dir [[ (js_workspace ~ "/" ~ react_root) | tojson ]] run typecheck
    pnpm --dir [[ (js_workspace ~ "/" ~ react_root) | tojson ]] run test:unit
    pnpm --dir [[ (js_workspace ~ "/" ~ react_root) | tojson ]] run test:integration
    pnpm --dir [[ (js_workspace ~ "/" ~ react_root) | tojson ]] run test:coverage
    pnpm --dir [[ (js_workspace ~ "/" ~ react_root) | tojson ]] run build
{% endif %}{% if node %}    pnpm --dir [[ (js_workspace ~ "/" ~ node_root) | tojson ]] run lint
    pnpm --dir [[ (js_workspace ~ "/" ~ node_root) | tojson ]] run typecheck
    pnpm --dir [[ (js_workspace ~ "/" ~ node_root) | tojson ]] run test:unit
    pnpm --dir [[ (js_workspace ~ "/" ~ node_root) | tojson ]] run test:integration
    pnpm --dir [[ (js_workspace ~ "/" ~ node_root) | tojson ]] run test:coverage
    pnpm --dir [[ (js_workspace ~ "/" ~ node_root) | tojson ]] run build
{% endif %}{% if python %}    uv --directory [[ python_root | tojson ]] run --locked ruff check [[ python_sources | tojson ]] [[ python_tests | tojson ]]
    uv --directory [[ python_root | tojson ]] run --locked ruff format --check [[ python_sources | tojson ]] [[ python_tests | tojson ]]
    uv --directory [[ python_root | tojson ]] run --locked pytest -q --ignore=[[ python_integration | tojson ]] [[ python_tests | tojson ]]
{% endif %}{% if shell %}    mise exec aqua:koalaman/shellcheck@0.11.0 -- shellcheck --severity=style [[ shell_sources | tojson ]]/*.sh
    mise exec aqua:mvdan/sh@3.14.1 -- shfmt -d -i 2 [[ shell_sources | tojson ]]/*.sh
    mise exec aqua:bats-core/bats-core@1.14.0 -- bats [[ shell_tests | tojson ]]
{% endif %}
    if [ "$(git rev-parse HEAD)" != "$START_HEAD" ]; then
      printf 'CI HEAD changed during verification: %s\n' "$START_HEAD" >&2
      exit 1
    fi
    if [ "${RILL_FULL:-0}" != "1" ]; then receipt pass; fi

# Resource-heavy browser and independent integration tests run locally, not on each PR VM.
ci-full:
    #!/usr/bin/env bash
    START_HEAD="$(git rev-parse HEAD)" || exit 1
    set -euo pipefail
    receipt() { if command -v rill >/dev/null 2>&1; then rill policy ci-receipt full "$1" "$START_HEAD"; fi; }
    receipt running
    RILL_FULL=1 just ci
{% if react %}    pnpm --dir [[ (js_workspace ~ "/" ~ react_root) | tojson ]] run test:e2e
    pnpm --dir [[ (js_workspace ~ "/" ~ react_root) | tojson ]] run test:a11y
{% endif %}{% if python %}    uv --directory [[ python_root | tojson ]] run --locked pytest -q [[ python_integration | tojson ]]
{% endif %}
    if [ "$(git rev-parse HEAD)" != "$START_HEAD" ]; then
      printf 'Full CI HEAD changed during verification: %s\n' "$START_HEAD" >&2
      exit 1
    fi
    receipt pass
