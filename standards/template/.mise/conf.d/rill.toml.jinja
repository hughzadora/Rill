# Managed by the versioned Rill CLI; native mise GitHub Release distribution.
[tools."github:hughzadora/Rill"]
version = "v[[ rill_release_version ]]"

[tools."github:hughzadora/Rill".platforms.linux-x64]
asset_pattern = "rill-linux-x64.tar.gz"
bin_path = "."

[tools."github:hughzadora/Rill".platforms.linux-arm64]
asset_pattern = "rill-linux-arm64.tar.gz"
bin_path = "."

[tools."github:hughzadora/Rill".platforms.macos-arm64]
asset_pattern = "rill-macos-arm64.tar.gz"
bin_path = "."
