{
  "name": "rill-typescript-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --no-env-file src/server.ts",
    "format": "oxfmt --write --disable-nested-config .",
    "format:check": "oxfmt --check --disable-nested-config .",
    "lint": "oxlint --type-aware --deny-warnings --disable-nested-config src scripts tests",
    "lint:fix": "oxlint --type-aware --disable-nested-config --fix src scripts tests",
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "architecture": "depcruise --config .dependency-cruiser.cjs --output-type err-long src",
    "architecture:info": "depcruise --info",
    "openapi:generate": "bun scripts/generate-openapi.ts",
    "openapi:check": "bun scripts/check-openapi.ts",
    "openapi:lint": "spectral lint --fail-severity error openapi.json",
    "openapi:compatibility": "oasdiff breaking --fail-on WARN contracts/baseline-openapi.json openapi.json",
    "test": "bun scripts/run-tests.ts ordinary",
    "test:behavior": "bun test ./tests/behavior/capacity.test.ts ./tests/behavior/configuration.test.ts ./tests/behavior/http.test.ts",
    "test:qualification": "bun scripts/run-tests.ts qualification",
    "test:mutation": "stryker run && bun scripts/check-mutation.ts",
    "unused": "node node_modules/knip/bin/knip.js"
  },
  "overrides": {
    "@stryker-mutator/core>minimatch": "11.0.1",
    "typed-rest-client>qs": "6.16.1"
  },
  "dependencies": {
    "@t3-oss/env-core": "0.13.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "6.17.1",
    "@stryker-mutator/core": "10.1.1",
    "@types/bun": "1.4.5",
    "dependency-cruiser": "18.9.0",
    "fast-check": "4.11.0",
    "knip": "6.48.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.5"
}
