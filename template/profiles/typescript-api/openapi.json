{
  "openapi": "3.0.3",
  "info": {
    "title": "Reservation Quote API",
    "description": "Quotes whether a party fits in the available seats without making a reservation.",
    "version": "1.0.0",
    "contact": {
      "name": "Reservation Quote API maintainers"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "tags": [
    {
      "name": "Quotes",
      "description": "Stateless reservation capacity quotes."
    }
  ],
  "paths": {
    "/v1/reservation-quotes": {
      "post": {
        "tags": [
          "Quotes"
        ],
        "operationId": "createReservationQuote",
        "summary": "Quote reservation capacity",
        "description": "Returns whether the requested number of seats fits the stated capacity.",
        "requestBody": {
          "description": "A JSON document of at most 1024 bytes.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requested": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "available": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "requested",
                  "available"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Capacity decision.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "accepted"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The JSON or its fields are invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "invalid-request"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "413": {
            "description": "The request exceeds the documented body limit.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "payload-too-large"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "415": {
            "description": "The request is missing the JSON media type.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "unsupported-media-type"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
